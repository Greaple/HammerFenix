{
  "name": "hammerfenix",
  "version": "0.1.0",
  "private": true,
  "description": "A modern web remake of Hammerfest (Motion Twin, 2006).",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "tsx tools/build-data.ts && tsx tools/build-swf.ts && tsx tools/build-site.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "orig": "tsx tools/normalize-original.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-xml-parser": "^5.11.2",
    "prettier": "^3.6.0",
    "swf-parser": "^0.14.1",
    "swf-types": "^0.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
